            RowBox[{"\[CapitalGamma]dcc", "[", "\[Mu]", "]"}], "]"}], "]"}]}],
          ",", 
         RowBox[{
          RowBox[{"\[CapitalGamma]uaa", "[", "\[Mu]", "]"}], "==", 
