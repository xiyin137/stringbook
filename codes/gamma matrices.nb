Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"dim", "=", "4"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"eps", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", "1"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "1"}], ",", "0"}], "}"}]}], "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"VerifyCliff", "[", "version_", "]"}], ":=", 
   RowBox[{"And", " ", "@@", " ", 
    RowBox[{"Flatten", "[", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"\[Gamma]", "[", 
           RowBox[{"version", ",", "\[Mu]"}], "]"}], ".", 
          RowBox[{"\[Gamma]", "[", 
           RowBox[{"version", ",", "\[Nu]"}], "]"}]}], "+", 
         RowBox[{
          RowBox[{"\[Gamma]", "[", 
           RowBox[{"version", ",", "\[Nu]"}], "]"}], ".", 
          RowBox[{"\[Gamma]", "[", 
           RowBox[{"version", ",", "\[Mu]"}], "]"}]}], "-", 
         RowBox[{"2", " ", 
          RowBox[{"\[Eta]", "[", 
           RowBox[{"\[Mu]", ",", "\[Nu]"}], "]"}], " ", 
          RowBox[{"IdentityMatrix", "[", "4", "]"}]}]}], "==", 
        RowBox[{"0", " ", 
         RowBox[{"IdentityMatrix", "[", "4", "]"}]}]}], ",", 
       RowBox[{"{", 
        RowBox[{"\[Mu]", ",", "0", ",", "3"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\[Nu]", ",", "0", ",", "3"}], "}"}]}], "]"}], "]"}]}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
