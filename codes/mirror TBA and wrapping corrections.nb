Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"**", " ", "the"}], " ", "function", " ", "\[Chi]", " ", "in", 
    " ", 
    RowBox[{"(", "23.101", ")"}]}], " ", "***)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"\[Chi]", "[", 
     RowBox[{"x_", ",", "y_", ",", "h_", ",", "rsorder_"}], "]"}], ":=", 
    RowBox[{"Sum", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"crs", "[", 
         RowBox[{"r", ",", "s", ",", "h"}], "]"}], "/", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"r", "-", "1"}], ")"}], 
          RowBox[{"(", 
           RowBox[{"s", "-", "1"}], ")"}]}], ")"}]}], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"1", "/", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"x", "^", 
             RowBox[{"(", 
              RowBox[{"r", "-", "1"}], ")"}]}], " ", 
            RowBox[{"y", "^", 
             RowBox[{"(", 
              RowBox[{"s", "-", "1"}], ")"}]}]}], ")"}]}], "-", 
         RowBox[{"1", "/", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"x", "^", 
             RowBox[{"(", 
              RowBox[{"s", "-", "1"}], ")"}]}], " ", 
            RowBox[{"y", "^", 
             RowBox[{"(", 
              RowBox[{"r", "-", "1"}], ")"}]}]}], ")"}]}]}], ")"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"r", ",", "2", ",", "rsorder"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"s", ",", 
        RowBox[{"r", "+", "1"}], ",", "rsorder", ",", "2"}], "}"}]}], "]"}]}],
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"**", " ", "coefficient"}], " ", 
     SubscriptBox["c", 
      RowBox[{"r", ",", "s"}]], 
     RowBox[{"(", "h", ")"}], " ", "in", " ", "the", " ", "weak", " ", 
     "coupling", " ", "expansion", " ", 
     RowBox[{"(", "23.108", ")"}]}], " ", "***)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"cWeak", "[", 
     RowBox[{"r_", ",", "s_", ",", "n_"}], "]"}], ":=", 
    RowBox[{"2", " ", 
     RowBox[{"Cos", "[", 
      RowBox[{"Pi", " ", 
       RowBox[{"n", "/", "2"}]}], "]"}], " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"-", "1"}], ")"}], "^", 
      RowBox[{"(", 
       RowBox[{"n", "+", "s"}], ")"}]}], " ", 
     RowBox[{"Zeta", "[", 
      RowBox[{"n", "+", "1"}], "]"}], " ", 
     RowBox[{"Gamma", "[", 
      RowBox[{"n", "+", "2"}], "]"}], " ", 
     RowBox[{"Gamma", "[", 
      RowBox[{"n", "+", "1"}], "]"}], " ", 
     RowBox[{"(", 
      RowBox[{"r", "-", "1"}], ")"}], 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"s", "-", "1"}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Gamma", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"n", "-", "r", "-", "s", "+", "5"}], ")"}], "/", "2"}], 
         "]"}], " ", 
        RowBox[{"Gamma", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"n", "+", "r", "-", "s", "+", "3"}], ")"}], "/", "2"}], 
         "]"}], 
        RowBox[{"Gamma", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"n", "-", "r", "+", "s", "+", "3"}], ")"}], "/", "2"}], 
         "]"}], 
        RowBox[{"Gamma", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"n", "+", "r", "+", "s", "+", "1"}], ")"}], "/", "2"}], 
         "]"}]}], ")"}]}]}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"crsWeak", "[", 
     RowBox[{"r_", ",", "s_", ",", "h_", ",", "horder_"}], "]"}], ":=", 
    RowBox[{"Sum", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"cWeak", "[", 
        RowBox[{"r", ",", "s", ",", "n"}], "]"}], " ", 
       RowBox[{"h", "^", 
        RowBox[{"(", 
         RowBox[{"n", "+", "1"}], ")"}]}]}], ",", 
      RowBox[{"{", 
       RowBox[{"n", ",", 
        RowBox[{"r", "+", "s", "-", "3"}], ",", "horder"}], "}"}]}], "]"}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Theta]", "[", 
      RowBox[{"h_", ",", "rsorder_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"\[Chi]", "[", 
       RowBox[{
        RowBox[{"xp", "[", "1", "]"}], ",", 
        RowBox[{"xp", "[", "2", "]"}], ",", "h", ",", "rsorder"}], "]"}], "+", 
      RowBox[{"\[Chi]", "[", 
       RowBox[{
        RowBox[{"xm", "[", "1", "]"}], ",", 
        RowBox[{"xm", "[", "2", "]"}], ",", "h", ",", "rsorder"}], "]"}], "-", 
      RowBox[{"\[Chi]", "[", 
       RowBox[{
        RowBox[{"xp", "[", "1", "]"}], ",", 
        RowBox[{"xm", "[", "2", "]"}], ",", "h", ",", "rsorder"}], "]"}], "-", 
      RowBox[{"\[Chi]", "[", 
       RowBox[{
        RowBox[{"xm", "[", "1", "]"}], ",", 
        RowBox[{"xp", "[", "2", "]"}], ",", "h", ",", "rsorder"}], "]"}]}]}], 
    ";"}]}]}]], "Input",
