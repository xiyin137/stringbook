Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"**", " ", "checking"}], " ", 
    RowBox[{"(", "23.130", ")"}]}], " ", "***)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"LHSp", "[", 
     RowBox[{"h_", ",", "m_", ",", "t_"}], "]"}], ":=", 
    RowBox[{"NIntegrate", "[", " ", 
     RowBox[{
      RowBox[{
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{
         RowBox[{"-", "\[ImaginaryI]"}], " ", "t", " ", "u"}]], " ", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"xp", "[", 
           RowBox[{"h", ",", "u"}], "]"}], ")"}], 
         RowBox[{"-", "m"}]], "/", 
        RowBox[{"(", 
         RowBox[{"2", "Pi"}], ")"}]}]}], ",", 
      RowBox[{"{", 
       RowBox[{"u", ",", 
        RowBox[{"-", "Infinity"}], ",", "Infinity"}], "}"}]}], "]"}]}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"RHSp", "[", 
