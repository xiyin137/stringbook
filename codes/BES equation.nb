Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Kz", "[", 
   RowBox[{"h_", ",", "t_", ",", "hord_", ",", "nn_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "l", "}"}], ",", 
    RowBox[{
     RowBox[{
      RowBox[{"BesselJ", "[", 
       RowBox[{"1", ",", "t"}], "]"}], "/", "t"}], "+", 
     RowBox[{
      RowBox[{"2", "/", "t"}], " ", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"-", "1"}], ")"}], "^", 
          RowBox[{"(", 
           RowBox[{"l", "-", "1"}], ")"}]}], " ", 
         RowBox[{"crsStrong", "[", 
          RowBox[{"2", ",", 
           RowBox[{
            RowBox[{"2", "l"}], "+", "1"}], ",", "h", ",", "hord"}], "]"}], 
         " ", 
         RowBox[{"BesselJ", "[", 
          RowBox[{
           RowBox[{"2", "l"}], ",", "t"}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"l", ",", "1", ",", "nn"}], "}"}]}], "]"}]}]}]}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"KOriginal", "[", 
    RowBox[{"h_", ",", "t_", ",", "t1_", ",", "hord_", ",", "nn_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"k", ",", "l"}], "}"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"BesselJ", "[", 
           RowBox[{"1", ",", "t"}], "]"}], " ", 
          RowBox[{"BesselJ", "[", 
           RowBox[{"0", ",", "t1"}], "]"}]}], "-", 
         RowBox[{
          RowBox[{"BesselJ", "[", 
           RowBox[{"0", ",", "t"}], "]"}], " ", 
          RowBox[{"BesselJ", "[", 
           RowBox[{"1", ",", "t1"}], "]"}]}]}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{"t", "-", "t1"}], ")"}]}], "+", 
      RowBox[{
       RowBox[{"4", "/", 
        RowBox[{"(", 
         RowBox[{"t", " ", "t1"}], ")"}]}], " ", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"-", "1"}], ")"}], "^", 
           RowBox[{"(", 
            RowBox[{"k", "+", "l"}], ")"}]}], " ", 
          RowBox[{"crsStrong", "[", 
           RowBox[{
            RowBox[{"2", "k"}], ",", 
            RowBox[{
             RowBox[{"2", "l"}], "+", "1"}], ",", "h", ",", "hord"}], "]"}], 
          " ", 
          RowBox[{"BesselJ", "[", 
           RowBox[{
            RowBox[{"2", "l"}], ",", "t"}], "]"}], " ", 
          RowBox[{"BesselJ", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"2", "k"}], "-", "1"}], ",", "t1"}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "1", ",", "nn"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"l", ",", "1", ",", "nn"}], "}"}]}], "]"}]}]}]}], "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"NN", "=", "5"}], ";", 
  RowBox[{"horder", "=", "5"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"htest", "=", "2."}], ";", 
  RowBox[{"testsize", "=", "8"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"KOriginal", "[", 
    RowBox[{"t_", ",", "t1_"}], "]"}], "=", 
   RowBox[{"KOriginal", "[", 
    RowBox[{"htest", ",", "t", ",", "t1", ",", "horder", ",", "NN"}], "]"}]}],
   ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Kz", "[", "t_", "]"}], "=", 
   RowBox[{"Kz", "[", 
    RowBox[{"htest", ",", "t", ",", "horder", ",", "NN"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"stest", "[", "t_", "]"}], "=", 
    RowBox[{"strial", "[", 
     RowBox[{"htest", ",", "t", ",", "testsize"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  StyleBox[
   RowBox[{
    RowBox[{"BESOriginal", "[", "t_", "]"}], ":=", 
    RowBox[{
     RowBox[{"Kz", "[", 
      RowBox[{"2", "htest", " ", "t"}], "]"}], " ", "-", " ", 
     RowBox[{"4", 
      RowBox[{"htest", "^", "2"}], " ", 
      RowBox[{"NIntegrate", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"KOriginal", "[", 
          RowBox[{
           RowBox[{"2", "htest", " ", "t"}], ",", 
           RowBox[{"2", "htest", " ", "t1"}]}], "]"}], " ", "*", " ", 
         RowBox[{"t1", "/", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"E", "^", "t1"}], "-", "1"}], ")"}]}], " ", "*", " ", 
         RowBox[{"stest", "[", "t1", "]"}]}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"t1", ",", "0", ",", "Infinity"}], "}"}]}], "]"}]}]}]}], 
   "Input"], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{
   StyleBox[
    RowBox[{"a", "=", 
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"stest", "[", "t", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", "5"}], "}"}], ",", 
       RowBox[{"PlotStyle", "->", "Red"}]}], "]"}]}], "Input"], 
   StyleBox[",", "Input"], "\[IndentingNewLine]", 
   StyleBox[
    RowBox[{"b", "=", 
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"BESOriginal", "[", "t", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", "5"}], "}"}], ",", 
       RowBox[{"PlotStyle", "->", "Blue"}]}], "]"}]}], "Input"]}], 
  StyleBox["}", "Input"]}], "\[IndentingNewLine]", 
 StyleBox[
  RowBox[{"Show", "[", 
   RowBox[{"a", ",", "b"}], "]"}], "Input"]}], "Input",
