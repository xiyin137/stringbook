Cell[CellGroupData[{

Cell["Simplifying BES equation (pseudo code)", "Subtitle",
 CellChangeTimes->{{3.966412348303871*^9, 3.966412367532007*^9}, {
  3.966429269658429*^9, 3.966429276891891*^9}, {3.966429782709119*^9, 
  3.966429784513073*^9}, {3.966430607498109*^9, 3.966430619173882*^9}, {
  3.9664306494194117`*^9, 
  3.966430653206831*^9}},ExpressionUUID->"ef21b677-e76a-4bcc-a462-\
1d698660b848"],

Cell[TextData[StyleBox["The BES equation (23.131) is equivalently written as\n\
s[t] == K[2h t, 0] - 4h^2 Integrate[K[2h t,2h t1] * t1/(E^t1-1) * s[t1], \
{t1,0,Infinity}],\n\nwhere \ns[t] = -(E^t-1)/t * \[Sigma][t].\n\nWe expand \n\
s[t] = Sum[ss[n] BesselJ[n,2h t]/(2h t),{n,1,Infinity}], \n\nand write BES \
equation as\n\ns[t] == Km[2h t, 0] + 2 Kc[2h t, 0] - 4h^2 Integrate[Km[2h \
t,2h t1] * t1/(E^t1-1) * s[t1], {t1,0,Infinity}] - 8 h^2 Integrate[Kc[2h t,2h \
t1] * t1/(E^t1-1) * s[t1], {t1,0,Infinity}].\n\nFollowing the notation of \
hep-th/0611135, here we split \nK[t,t1] = Km[t1,t1] + 2Kc[t,t1].\n\nUsing the \
identities checked above,\n\nKm[t,t1] = 2/(t t1) Sum[n BesselJ[n,t] \
BesselJ[n,t1], {n,1,Infinity}],\nK0[t,t1] = 2/(t t1) Sum[(2n-1) \
BesselJ[2n-1,t] BesselJ[2n-1,t1], {n,1,Infinity}],\nK1[t,t1] = 2/(t t1) \
Sum[(2n) BesselJ[2n,t] BesselJ[2n,t1], {n,1,Infinity}],\n\nand most \
nontrivially the magic kernel expression\n\nKc[t,t1] = Sum[8n(2m-1)/(t t1) \
Z[h, 2n,2m-1] BesselJ[2n,t] BesselJ[2m-1,t1], {n,1,Infinity}, \
{m,1,Infinity}],\n\nwhere \nZ[h, n,m] = Integrate[BesselJ[m,2h t] BesselJ[n, \
2h t]/(t(E^t-1)), {t,0,Infinity}],\n\nwe can rewrite BES equation as\n\n\
Sum[ss[n] BesselJ[n,2h t]/(2h t),{n,1,Infinity}]\n== 2/(2h t) Sum[n \
BesselJ[n,2h t] (D[BesselJ[n,t1],t1]/.t1->0), {n,1,Infinity}]\n  + 2 \
Sum[8n(2m-1)/(2h t) Z[h, 2n,2m-1] BesselJ[2n,2h t] \
(D[BesselJ[2m-1,t1],t1]/.t1->0), {n,1,Infinity}, {m,1,Infinity}]\n  - 4h^2 \
Sum[ss[n] * Integrate[Km[2h t,2h t1] * t1/(E^t1-1) * BesselJ[n,2h t1]/(2h \
t1), {t1,0,Infinity}], {n,1,Infinity}]\n  - 8h^2 Sum[ss[n] * Integrate[Kc[2h \
t,2h t1] * t1/(E^t1-1) * BesselJ[n,2h t1]/(2h t1), {t1,0,Infinity}], \
{n,1,Infinity}],\n\nand one step further,\n\nSum[ss[n] BesselJ[n,2h t]/(2h \
t),{n,1,Infinity}]\n== 2/(2h t) Sum[n BesselJ[n,2h t] \
(D[BesselJ[n,t1],t1]/.t1->0), {n,1,Infinity}]\n  + 2 Sum[8n(2m-1)/(2h t) Z[h, \
2n,2m-1] BesselJ[2n,2h t] (D[BesselJ[2m-1,t1],t1]/.t1->0), {n,1,Infinity}, \
{m,1,Infinity}]\n  - 4h^2 Sum[ss[n] * Integrate[2/(2h t 2h t1) Sum[m \
BesselJ[m,2h t] BesselJ[m,2h t1], {m,1,Infinity}] * t1/(E^t1-1) * \
BesselJ[n,2h t1]/(2h t1), {t1,0,Infinity}], {n,1,Infinity}]\n  - 8h^2 \
Sum[ss[n] * Integrate[Sum[8k(2m-1)/(2h t 2h t1) Z[h, 2k,2m-1] BesselJ[2k,2h \
t] BesselJ[2m-1,2h t1], {k,1,Infinity}, {m,1,Infinity}] * t1/(E^t1-1) * \
BesselJ[n,2h t1]/(2h t1), {t1,0,Infinity}], {n,1,Infinity}].\n\nStripping off \
BesselJ[n,2h t]/(2h t) from both sides, we get\n\nss[n]\n== 2 n \
(D[BesselJ[n,t1],t1]/.t1->0)\n  + 2 KroneckerDelta[2k,n] Sum[8k(2m-1) Z[h, \
2k,2m-1] (D[BesselJ[2m-1,t1],t1]/.t1->0), {m,1,Infinity}]\n  - 4h^2 Sum[ss[k] \
* Integrate[2/(2h t1) n BesselJ[n,2h t1] * t1/(E^t1-1) * BesselJ[k,2h t1]/(2h \
t1), {t1,0,Infinity}], {k,1,Infinity}]\n  - 8h^2 Sum[ss[l] * \
Integrate[Sum[8k(2m-1)/(2h t1) KroneckerDelta[2k,n] Z[h, 2k,2m-1] \
BesselJ[2m-1,2h t1], {m,1,Infinity}] * t1/(E^t1-1) * BesselJ[l,2h t1]/(2h \
t1), {t1,0,Infinity}], {l,1,Infinity}].\n  \nThis is now of the form\nss[n] \
== hh[n] + Sum[KK[n,m] ss[m], {m,1,Infinity}],\n\nwhere\nhh[n] = 2 n \
(D[BesselJ[n,t1],t1]/.t1->0)\n  + 2 KroneckerDelta[2k,n] Sum[8k(2m-1) Z[h, \
2k,2m-1] (D[BesselJ[2m-1,t1],t1]/.t1->0), {m,1,Infinity}],\n\nand\nKK[n,m] = \
- 4h^2 Integrate[2/(2h t1) n BesselJ[n,2h t1] * t1/(E^t1-1) * BesselJ[m,2h \
t1]/(2h t1), {t1,0,Infinity}]\n  - 8h^2 Integrate[Sum[8k(2p-1)/(2h t1) \
KroneckerDelta[2k,n] Z[h, 2k,2p-1] BesselJ[2p-1,2h t1], {p,1,Infinity}] * \
t1/(E^t1-1) * BesselJ[m,2h t1]/(2h t1), {t1,0,Infinity}]  ", "Input"]], "Text",\

 CellChangeTimes->{{3.9663773308412237`*^9, 3.966377336800036*^9}, {
   3.966377405297175*^9, 3.966377466610546*^9}, {3.966377938792592*^9, 
   3.966377938936357*^9}, {3.966378315164927*^9, 3.9663784535655613`*^9}, {
   3.966378586005664*^9, 3.966378703751206*^9}, 3.966378752736719*^9, {
   3.966378783082288*^9, 3.966378954137452*^9}, {3.9663790417166157`*^9, 
   3.96637905929802*^9}, {3.96637910126324*^9, 3.966379164337576*^9}, {
   3.966379234474662*^9, 3.9663793401622133`*^9}, 3.966379371057219*^9, {
   3.966379496763506*^9, 3.966379629926682*^9}, {3.9663796611067257`*^9, 
   3.966379736053083*^9}, {3.966379776733212*^9, 3.96637991163034*^9}, {
   3.966379964418899*^9, 3.966380136904183*^9}, {3.966380177869295*^9, 
   3.966380189735772*^9}, {3.966380256503454*^9, 3.966380389171702*^9}, {
   3.9663804326394167`*^9, 3.966380528204677*^9}, {3.966430623568183*^9, 
   3.9664309327623672`*^9}},ExpressionUUID->"f92e1465-3ce0-4948-aa9c-\
b49b0b8ba151"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Now the numerical implementation", "Subtitle",
 CellChangeTimes->{{3.966412348303871*^9, 3.966412367532007*^9}, {
  3.966429269658429*^9, 3.966429276891891*^9}, {3.966429782709119*^9, 
  3.966429784513073*^9}, {3.966430607498109*^9, 3.966430619173882*^9}, {
  3.9664306494194117`*^9, 3.966430653206831*^9}, {3.966430947360009*^9, 
  3.966430952518732*^9}},ExpressionUUID->"be884880-9630-46a5-a6c9-\
75d29b9b7a61"],

Cell[BoxData[{
 RowBox[{
  StyleBox[
   RowBox[{
    RowBox[{"hh", "[", 
     RowBox[{"h_", ",", "n_"}], "]"}], ":=", " ", 
    RowBox[{
     RowBox[{"2", " ", "n", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"1", "/", "2"}], " ", 
        RowBox[{"KroneckerDelta", "[", 
         RowBox[{"n", ",", "1"}], "]"}]}], ")"}]}], "+", " ", 
     RowBox[{"2", " ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"EvenQ", "[", "n", "]"}], ",", "1", ",", "0"}], "]"}], " ", 
      "4", "n", " ", 
      RowBox[{"Z", "[", 
       RowBox[{"h", ",", " ", "n", ",", "1"}], "]"}], " ", 
      RowBox[{"(", 
       RowBox[{"1", "/", "2"}], ")"}]}]}]}], "Input"], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  StyleBox[
   RowBox[{
    RowBox[{"KK", "[", 
     RowBox[{"h_", ",", "n_", ",", "m_", ",", "cutoff_"}], "]"}], ":=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"-", " ", "4"}], 
      RowBox[{"h", "^", "2"}], " ", 
      RowBox[{"NIntegrate", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"2", "/", 
          RowBox[{"(", 
           RowBox[{"2", "h", " ", "t1"}], ")"}]}], " ", "n", " ", 
         RowBox[{"BesselJ", "[", 
          RowBox[{"n", ",", 
           RowBox[{"2", "h", " ", "t1"}]}], "]"}], " ", "*", " ", 
         RowBox[{"t1", "/", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"E", "^", "t1"}], "-", "1"}], ")"}]}], " ", "*", " ", 
         RowBox[{
          RowBox[{"BesselJ", "[", 
           RowBox[{"m", ",", 
            RowBox[{"2", "h", " ", "t1"}]}], "]"}], "/", 
          RowBox[{"(", 
           RowBox[{"2", "h", " ", "t1"}], ")"}]}]}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"t1", ",", "0", ",", "Infinity"}], "}"}]}], "]"}]}], "-", 
     " ", 
     RowBox[{"8", 
      RowBox[{"h", "^", "2"}], " ", 
      RowBox[{"NIntegrate", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{"4", "n", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"2", "p"}], "-", "1"}], ")"}], "/", 
             RowBox[{"(", 
              RowBox[{"2", "h", " ", "t1"}], ")"}]}], " ", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"EvenQ", "[", "n", "]"}], ",", "1", ",", "0"}], "]"}], 
            " ", 
            RowBox[{"Z", "[", 
             RowBox[{"h", ",", " ", "n", ",", 
              RowBox[{
               RowBox[{"2", "p"}], "-", "1"}]}], "]"}], " ", 
            RowBox[{"BesselJ", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"2", "p"}], "-", "1"}], ",", 
              RowBox[{"2", "h", " ", "t1"}]}], "]"}]}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"p", ",", "1", ",", "cutoff"}], "}"}]}], "]"}], " ", "*", 
         " ", 
         RowBox[{"t1", "/", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"E", "^", "t1"}], "-", "1"}], ")"}]}], " ", "*", " ", 
         RowBox[{
          RowBox[{"BesselJ", "[", 
           RowBox[{"m", ",", 
            RowBox[{"2", "h", " ", "t1"}]}], "]"}], "/", 
          RowBox[{"(", 
           RowBox[{"2", "h", " ", "t1"}], ")"}]}]}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"t1", ",", "0", ",", "Infinity"}], "}"}]}], "]"}]}]}]}], 
   "Input"], 
  StyleBox["\[IndentingNewLine]", "Input"]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"hvector", "[", 
   RowBox[{"h_", ",", "size_"}], "]"}], ":=", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"hh", "[", 
     RowBox[{"h", ",", "n"}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"n", ",", "1", ",", "size"}], "}"}]}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Kmatrix", "[", 
    RowBox[{"h_", ",", "size_"}], "]"}], ":=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"KK", "[", 
      RowBox[{"h", ",", "n", ",", "m", ",", "size"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"n", ",", "1", ",", "size"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"m", ",", "1", ",", "size"}], "}"}]}], "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"svector", "[", "size_", "]"}], ":=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"svar", "[", "n", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"n", ",", "1", ",", "size"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"ssol", "[", 
    RowBox[{"h_", ",", "size_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"ssol", "[", 
     RowBox[{"h", ",", "size"}], "]"}], "=", 
    RowBox[{
     RowBox[{"Solve", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"svector", "[", "size", "]"}], "==", 
        RowBox[{
         RowBox[{"hvector", "[", 
          RowBox[{"h", ",", "size"}], "]"}], "+", 
         RowBox[{
          RowBox[{"Transpose", "[", 
           RowBox[{
            RowBox[{"Kmatrix", "[", 
             RowBox[{"h", ",", "size"}], "]"}], ".", 
            RowBox[{"Transpose", "[", 
             RowBox[{"{", 
              RowBox[{"svector", "[", "size", "]"}], "}"}], "]"}]}], "]"}], 
          "[", 
          RowBox[{"[", "1", "]"}], "]"}]}]}], ",", 
       RowBox[{"svector", "[", "size", "]"}]}], "]"}], "[", 
     RowBox[{"[", "1", "]"}], "]"}]}]}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"strial", "[", 
    RowBox[{"h_", ",", "t_", ",", "size_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"Sum", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"svar", "[", "n", "]"}], " ", 
       RowBox[{
        RowBox[{"BesselJ", "[", 
         RowBox[{"n", ",", 
          RowBox[{"2", "h", " ", "t"}]}], "]"}], "/", 
        RowBox[{"(", 
         RowBox[{"2", "h", " ", "t"}], ")"}]}]}], ",", 
      RowBox[{"{", 
       RowBox[{"n", ",", "1", ",", "size"}], "}"}]}], "]"}], "/.", 
    RowBox[{"ssol", "[", 
     RowBox[{"h", ",", "size"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[CapitalGamma]cusp", "[", 
   RowBox[{"h_", ",", "size_"}], "]"}], ":=", 
  RowBox[{"4", 
   RowBox[{"h", "^", "2"}], 
   RowBox[{"(", 
    RowBox[{"1", "+", 
     RowBox[{"4", "h", " ", 
      RowBox[{"NIntegrate", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"-", "t"}], "/", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"E", "^", "t"}], "-", "1"}], ")"}]}], " ", 
         RowBox[{"strial", "[", 
          RowBox[{"h", ",", "t", ",", "size"}], "]"}], " ", 
         RowBox[{
          RowBox[{"BesselJ", "[", 
           RowBox[{"1", ",", 
            RowBox[{"2", "h", " ", "t"}]}], "]"}], "/", "t"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"t", ",", "0", ",", "Infinity"}], "}"}]}], "]"}]}]}], 
    ")"}]}]}]}], "Input",
