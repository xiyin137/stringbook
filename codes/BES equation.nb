Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"**", " ", "comparison"}], " ", "with", " ", 
     RowBox[{"(", "23.136", ")"}]}], ",", " ", 
    RowBox[{
    "also", " ", "accounting", " ", "for", " ", "the", " ", "next", " ", 
     "order", " ", 
     RowBox[{"(", 
      RowBox[{
      "for", " ", "higher", " ", "orders", " ", "in", " ", "the", " ", 
       "strong", " ", "coupling", " ", "expansion", " ", "see", " ", 
       RowBox[{"arXiv", ":", "0708.3933"}]}], ")"}]}]}], " ", "***)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"\[CapitalGamma]target", "[", "h_", "]"}], ":=", 
   RowBox[{
    RowBox[{"2", "h"}], "-", 
    RowBox[{"3", 
     RowBox[{
      RowBox[{"Log", "[", "2", "]"}], "/", 
      RowBox[{"(", 
       RowBox[{"2", "Pi"}], ")"}]}]}], "-", 
    RowBox[{"Catalan", "/", 
     RowBox[{"(", 
      RowBox[{"8", 
       RowBox[{"Pi", "^", "2"}], " ", "h"}], ")"}]}]}]}]}]], "Input",
 CellLabel->
  "In[646]:=",ExpressionUUID->"3d43578a-6252-474f-81ab-522949240f09"],

