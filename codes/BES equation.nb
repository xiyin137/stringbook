       RowBox[{"2", "/", 
        RowBox[{"(", 
         RowBox[{"t", " ", "t1"}], ")"}]}], " ", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"-", "1"}], ")"}], "^", 
           RowBox[{"(", 
            RowBox[{"k", "+", "l"}], ")"}]}], " ", 
          RowBox[{"crsStrong", "[", 
           RowBox[{
            RowBox[{"2", "k"}], ",", 
            RowBox[{
             RowBox[{"2", "l"}], "+", "1"}], ",", "h", ",", "hord"}], "]"}], 
          " ", 
          RowBox[{"BesselJ", "[", 
           RowBox[{
            RowBox[{"2", "l"}], ",", "t"}], "]"}], " ", 
          RowBox[{"BesselJ", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"2", "k"}], "-", "1"}], ",", "t1"}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "1", ",", "nn"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"l", ",", "1", ",", "nn"}], "}"}]}], "]"}]}]}], "]"}]}], 
   "\[IndentingNewLine]", 
   StyleBox["\[IndentingNewLine]", "Input"], 
   StyleBox[
    RowBox[{"(*", 
     RowBox[{
      RowBox[{"**", " ", "the"}], " ", "magic", " ", "kernel"}], " ", 
     "***)"}], "Input"], 
   StyleBox["\[IndentingNewLine]", "Input"], 
   StyleBox[
    RowBox[{
     RowBox[{
      RowBox[{"Kc", "[", 
       RowBox[{"h_", ",", "t_", ",", "t1_"}], "]"}], " ", ":=", " ", 
      RowBox[{"4", 
       RowBox[{"h", "^", "2"}], " ", 
       RowBox[{"NIntegrate", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"K1", "[", 
           RowBox[{"t", ",", 
            RowBox[{"2", "h", " ", "t2"}]}], "]"}], " ", 
          RowBox[{"t2", "/", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"E", "^", "t2"}], "-", "1"}], ")"}]}], " ", "*", " ", 
          RowBox[{"K0", "[", 
           RowBox[{
            RowBox[{"2", "h", " ", "t2"}], ",", "t1"}], "]"}]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"t2", ",", "0", ",", "Infinity"}], "}"}]}], "]"}]}]}], 
     ";"}], "Input"], 
   StyleBox["\[IndentingNewLine]", "Input"], 
   StyleBox["\n", "Input"], 
   StyleBox[
    RowBox[{"(*", 
     RowBox[{
      RowBox[{"**", " ", "decomposition"}], " ", "of", " ", "magic", " ", 
      "kernel"}], " ", "***)"}], "Input"], 
   StyleBox["\[IndentingNewLine]", "Input"], 
   StyleBox[
    RowBox[{
     RowBox[{
      RowBox[{"Z", "[", 
       RowBox[{"h_", ",", " ", "n_", ",", "m_"}], "]"}], " ", ":=", " ", 
      RowBox[{"NIntegrate", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"BesselJ", "[", 
          RowBox[{"m", ",", 
           RowBox[{"2", "h", " ", "t"}]}], "]"}], " ", 
         RowBox[{
          RowBox[{"BesselJ", "[", 
           RowBox[{"n", ",", " ", 
            RowBox[{"2", "h", " ", "t"}]}], "]"}], "/", 
          RowBox[{"(", 
           RowBox[{"t", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"E", "^", "t"}], "-", "1"}], ")"}]}], ")"}]}]}], ",", 
        " ", 
        RowBox[{"{", 
         RowBox[{"t", ",", "0", ",", "Infinity"}], "}"}]}], "]"}]}], ";"}], 
    "Input"], 
   StyleBox["\[IndentingNewLine]", "Input"], 
   StyleBox[
    RowBox[{
     RowBox[{
      RowBox[{"KcSum", "[", 
       RowBox[{"h_", ",", "t_", ",", "t1_", ",", "cutoff_"}], "]"}], " ", ":=",
       " ", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{"8", "n", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"2", "m"}], "-", "1"}], ")"}], "/", 
          RowBox[{"(", 
           RowBox[{"t", " ", "t1"}], ")"}]}], " ", 
         RowBox[{"Z", "[", 
          RowBox[{"h", ",", " ", 
           RowBox[{"2", "n"}], ",", 
           RowBox[{
            RowBox[{"2", "m"}], "-", "1"}]}], "]"}], " ", 
         RowBox[{"BesselJ", "[", 
          RowBox[{
           RowBox[{"2", "n"}], ",", "t"}], "]"}], " ", 
         RowBox[{"BesselJ", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"2", "m"}], "-", "1"}], ",", "t1"}], "]"}]}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"n", ",", "1", ",", "cutoff"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"m", ",", "1", ",", "cutoff"}], "}"}]}], "]"}]}], ";"}], 
    "Input"], "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"**", " ", "checking"}], " ", "that", " ", "they", " ", "are", 
     " ", "all", " ", "the", " ", "same"}], " ", "***)"}], 
   StyleBox["\[IndentingNewLine]", "Input"], 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"KcOriginal", "[", 
      RowBox[{"2.", ",", "2.", ",", ".5", ",", "10", ",", "10"}], "]"}], ",", 
     
     RowBox[{"Kc", "[", 
      RowBox[{"2.", ",", "2.", ",", ".5"}], "]"}], ",", 
     RowBox[{"KcSum", "[", 
      RowBox[{"2.", ",", "2.", ",", ".5", ",", "5"}], "]"}]}], 
    "}"}]}]}]], "Input",
 CellChangeTimes->{{3.966429388288858*^9, 3.966429467682425*^9}, 
   3.9664295499387493`*^9, {3.966429758377047*^9, 3.966429765160789*^9}, {
