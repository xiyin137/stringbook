64a699074599"],

Cell["Preliminaries", "Subtitle",
 CellChangeTimes->{{3.966412348303871*^9, 
  3.966412367532007*^9}},ExpressionUUID->"7045f53e-3e34-443f-b74b-\
93316ee28005"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"**", " ", "express"}], " ", 
    SuperscriptBox["x", "+"], " ", "and", " ", 
    SuperscriptBox["x", "-"], " ", "as", " ", "functions", " ", "of", " ", 
    "the", " ", "spectral", " ", "parameter", " ", "u"}], " ", "***)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"usub", "=", 
     RowBox[{
      RowBox[{"Solve", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"xp", "+", 
            RowBox[{"1", "/", "xp"}]}], "==", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"u", "+", 
              RowBox[{"I", "/", "2"}]}], ")"}], "/", "h"}]}], ",", 
          RowBox[{
           RowBox[{"xm", "+", 
            RowBox[{"1", "/", "xm"}]}], "==", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"u", "-", 
              RowBox[{"I", "/", "2"}]}], ")"}], "/", "h"}]}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"xp", ",", "xm"}], "}"}]}], "]"}], "[", 
      RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"xptrial", "[", 
      RowBox[{"h_", ",", "u_"}], "]"}], "=", 
     RowBox[{"xp", "/.", "usub"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"xmtrial", "[", 
      RowBox[{"h_", ",", "u_"}], "]"}], "=", 
     RowBox[{"xm", "/.", "usub"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"**", " ", "wrong"}], " ", "branch"}], " ", "***)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Re", "[", 
           RowBox[{"xptrial", "[", 
            RowBox[{"h", ",", "u"}], "]"}], "]"}], ",", 
          RowBox[{"Im", "[", 
           RowBox[{"xptrial", "[", 
            RowBox[{"h", ",", "u"}], "]"}], "]"}]}], "}"}], "/.", 
        RowBox[{"{", 
         RowBox[{"h", "->", "2."}], "}"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"u", ",", 
         RowBox[{"-", "5"}], ",", "5"}], "}"}]}], "]"}], ",", 
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Re", "[", 
           RowBox[{"xmtrial", "[", 
            RowBox[{"h", ",", "u"}], "]"}], "]"}], ",", 
          RowBox[{"Im", "[", 
           RowBox[{"xmtrial", "[", 
            RowBox[{"h", ",", "u"}], "]"}], "]"}]}], "}"}], "/.", 
        RowBox[{"{", 
         RowBox[{"h", "->", "2."}], "}"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"u", ",", 
         RowBox[{"-", "5"}], ",", "5"}], "}"}]}], "]"}]}], "}"}]}]}]], "Input",\

