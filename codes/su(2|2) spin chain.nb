Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"**", " ", "checking"}], " ", "that", " ", "DHMcrossx", " ", 
      "and", " ", "DHMcrossxy", " ", "smoothly", " ", "join", " ", "across"}],
      " ", "|", "x", "|"}], "=", 
    RowBox[{
     RowBox[{"1", " ", "in", " ", "the", " ", "case", " ", "y"}], "=", 
     RowBox[{
      RowBox[{".8", " ", "and", " ", "h"}], "=", "3.3"}]}]}], " ", "***)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"dhmplot", "=", 
     RowBox[{"ListPlot", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"E", "^", "x"}], ",", 
          RowBox[{
           RowBox[{"DHMcrossy", "[", 
            RowBox[{
             RowBox[{"E", "^", 
              RowBox[{"(", 
               RowBox[{"x", "+", 
                RowBox[{".3", " ", "I"}]}], ")"}]}], ",", ".8", ",", "3.3"}], 
