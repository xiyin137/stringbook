    RowBox[{
     RowBox[{
      RowBox[{"H", "^", "2"}], "==", 
      RowBox[{"1", "+", 
       RowBox[{"4", " ", "K", " ", "Kbar"}]}], "==", 
      RowBox[{"1", "+", 
       RowBox[{"16", " ", 
        RowBox[{"h", "^", "2"}], " ", 
        RowBox[{
         RowBox[{"Sin", "[", 
          RowBox[{"p", "/", "2"}], "]"}], "^", "2"}]}]}]}], "/.", "xsub"}], "//",
     "FullSimplify"}]}]}]], "Input",
