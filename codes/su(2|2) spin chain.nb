Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"**", " ", 
    RowBox[{"Warning", ":", " ", 
     RowBox[{
     "formula", " ", "for", " ", "the", " ", "analytic", " ", "continuation", 
      " ", "fails", " ", "when", " ", "y", " ", "is", " ", "too", " ", "far", 
      " ", "from", " ", "the", " ", "unit", " ", 
      RowBox[{"circle", "!"}]}]}]}], " ", "***)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"dhmplot", "=", 
     RowBox[{"ListPlot", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"E", "^", "x"}], ",", 
          RowBox[{
           RowBox[{"DHMcrossy", "[", 
            RowBox[{
             RowBox[{"E", "^", 
              RowBox[{"(", 
               RowBox[{"x", "+", 
                RowBox[{".3", " ", "I"}]}], ")"}]}], ",", 
             RowBox[{".5", "+", 
              RowBox[{".5", " ", "I"}]}], ",", "3.3"}], "]"}], "//", "Re"}]}],
          "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"x", ",", "0.01", ",", ".5", ",", ".01"}], "}"}]}], "]"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"dhmcrossplot", "=", 
     RowBox[{"ListPlot", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"E", "^", "x"}], ",", 
          RowBox[{
           RowBox[{"DHMcrossxy", "[", 
            RowBox[{
             RowBox[{"E", "^", 
              RowBox[{"(", 
               RowBox[{"x", "+", 
                RowBox[{".3", " ", "I"}]}], ")"}]}], ",", 
             RowBox[{".5", "+", 
              RowBox[{".5", " ", "I"}]}], ",", "3.3"}], "]"}], "//", "Re"}]}],
          "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"x", ",", 
          RowBox[{"-", ".5"}], ",", 
          RowBox[{"-", "0.01"}], ",", ".01"}], "}"}]}], "]"}], "]"}]}], ";"}],
    "\[IndentingNewLine]", 
   RowBox[{"Show", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"dhmplot", ",", "dhmcrossplot"}], "}"}], ",", 
     RowBox[{"PlotRange", "->", "All"}]}], "]"}]}]}]], "Input",
