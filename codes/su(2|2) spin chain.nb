             RowBox[{"E", "^", 
              RowBox[{"(", 
               RowBox[{"x", "+", 
                RowBox[{".3", " ", "I"}]}], ")"}]}], ",", ".8", ",", "3.3"}], 
            "]"}], "//", "Re"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"x", ",", 
          RowBox[{"-", ".5"}], ",", 
          RowBox[{"-", "0.01"}], ",", ".01"}], "}"}]}], "]"}], "]"}]}], ";"}],
    "\[IndentingNewLine]", 
   RowBox[{"Show", "[", 
    RowBox[{
     RowBox[{"{", 
