        RowBox[{"{", 
         RowBox[{"x", ",", "0.01", ",", ".5", ",", ".01"}], "}"}]}], "]"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"dhmcrossplot", "=", 
     RowBox[{"ListPlot", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"E", "^", "x"}], ",", 
