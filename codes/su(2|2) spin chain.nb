Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"**", " ", 
     RowBox[{"(", "23.67", ")"}]}], ",", " ", 
    RowBox[{"(", "23.85", ")"}], ",", " ", 
    RowBox[{"(", "23.98", ")"}], ",", " ", 
    RowBox[{"and", " ", 
     RowBox[{"(", "23.102", ")"}], " ", "in", " ", "my", " ", "notes"}]}], 
   " ", "***)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"disp", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"xp", "/", "xm"}], "==", 
        RowBox[{"E", "^", 
         RowBox[{"(", 
          RowBox[{"I", " ", "p"}], ")"}]}]}], ",", 
       RowBox[{
        RowBox[{"xp", "+", 
         RowBox[{"1", "/", "xp"}]}], "==", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"u", "+", 
           RowBox[{"I", "/", "2"}]}], ")"}], "/", "h"}]}], ",", 
       RowBox[{
        RowBox[{"xm", "+", 
         RowBox[{"1", "/", "xm"}]}], "==", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"u", "-", 
           RowBox[{"I", "/", "2"}]}], ")"}], "/", "h"}]}], ",", 
       RowBox[{
        RowBox[{"x", "+", 
         RowBox[{"1", "/", "x"}]}], "==", 
        RowBox[{"u", "/", "h"}]}], ",", 
       RowBox[{"xp", "==", 
        RowBox[{"I", " ", 
         RowBox[{"d", "/", "b"}]}]}], ",", 
       RowBox[{"xm", "==", 
        RowBox[{
         RowBox[{"-", "I"}], " ", 
         RowBox[{"a", "/", "c"}]}]}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"a", " ", "d"}], "-", 
         RowBox[{"b", " ", "c"}]}], "==", "1"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"a", " ", "d"}], "+", 
         RowBox[{"b", " ", "c"}]}], "==", "H"}], ",", 
       RowBox[{"K", "==", 
        RowBox[{"a", " ", "b"}]}], ",", 
       RowBox[{"Kbar", "==", 
        RowBox[{"c", " ", "d"}]}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"**", " ", "express"}], " ", "all", " ", "variables", " ", "in", 
     " ", "terms", " ", "of", " ", "x"}], " ", "***)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"xsub", "=", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Solve", "[", 
         RowBox[{"disp", ",", 
          RowBox[{"{", 
           RowBox[{
           "H", ",", "b", ",", "c", ",", "d", ",", "K", ",", "Kbar", ",", "p",
             ",", "xp", ",", "xm", ",", "u"}], "}"}]}], "]"}], "[", 
        RowBox[{"[", "2", "]"}], "]"}], "/.", 
       RowBox[{"{", 
        RowBox[{
         TemplateBox[{"1"},
          "C"], "->", "0"}], "}"}]}], "//", "Simplify"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"**", " ", "express"}], " ", "all", " ", "variables", " ", "in", 
     " ", "terms", " ", "of", " ", "u"}], " ", "***)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"usub", "=", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Solve", "[", 
         RowBox[{"disp", ",", 
          RowBox[{"{", 
           RowBox[{
           "H", ",", "b", ",", "c", ",", "d", ",", "K", ",", "Kbar", ",", "p",
             ",", "xp", ",", "xm", ",", "x"}], "}"}]}], "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}], "/.", 
       RowBox[{"{", 
        RowBox[{
         TemplateBox[{"1"},
          "C"], "->", "0"}], "}"}]}], "//", "Simplify"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"**", " ", "verifying"}], " ", 
     RowBox[{"(", "23.68", ")"}], " ", "and", " ", 
     RowBox[{"(", "23.85", ")"}]}], " ", "***)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"xp", "+", 
       RowBox[{"1", "/", "xp"}], "-", "xm", "-", 
       RowBox[{"1", "/", "xm"}]}], "==", 
      RowBox[{"I", "/", "h"}]}], "/.", "xsub"}], "//", "FullSimplify"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"H", "==", 
      RowBox[{
       RowBox[{"-", "1"}], "-", 
       RowBox[{"2", "I", " ", "h", 
        RowBox[{"(", 
         RowBox[{"xp", "-", "xm"}], ")"}]}]}], "==", 
      RowBox[{"1", "+", 
       RowBox[{"2", "I", " ", "h", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"1", "/", "xp"}], "-", 
          RowBox[{"1", "/", "xm"}]}], ")"}]}]}]}], "/.", "xsub"}], "//", 
    "FullSimplify"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"H", "^", "2"}], "==", 
      RowBox[{"1", "+", 
       RowBox[{"4", " ", "K", " ", "Kbar"}]}], "==", 
      RowBox[{"1", "+", 
       RowBox[{"16", " ", 
        RowBox[{"h", "^", "2"}], " ", 
        RowBox[{
         RowBox[{"Sin", "[", 
          RowBox[{"p", "/", "2"}], "]"}], "^", "2"}]}]}]}], "/.", "xsub"}], "//",
     "FullSimplify"}]}]}]], "Input",
