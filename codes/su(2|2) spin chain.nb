  RowBox[{
   RowBox[{
    RowBox[{"levelIIsub", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"f", "[", "i_", "]"}], ":>", 
        RowBox[{
         RowBox[{"a", "[", "i", "]"}], "/", 
         RowBox[{"(", 
          RowBox[{"y", "-", 
           RowBox[{"xp", "[", "i", "]"}]}], ")"}]}]}], ",", 
       RowBox[{
        RowBox[{"SII", "[", "i_", "]"}], ":>", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"y", "-", 
           RowBox[{"xm", "[", "i", "]"}]}], ")"}], "/", 
         RowBox[{"(", 
          RowBox[{"y", "-", 
           RowBox[{"xp", "[", "i", "]"}]}], ")"}]}]}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"**", " ", "verifying"}], " ", 
