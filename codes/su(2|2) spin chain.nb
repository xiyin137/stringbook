   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"f", "[", "1", "]"}], " ", "L12"}], "+", 
         RowBox[{
          RowBox[{"f", "[", "2", "]"}], " ", 
          RowBox[{"SII", "[", "1", "]"}], " ", "H12"}]}], "==", 
        RowBox[{"A12", " ", 
         RowBox[{"f", "[", "1", "]"}], " ", 
         RowBox[{"SII", "[", "2", "]"}]}]}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"f", "[", "1", "]"}], " ", "K12"}], "+", 
         RowBox[{
          RowBox[{"f", "[", "2", "]"}], " ", 
          RowBox[{"SII", "[", "1", "]"}], " ", "G12"}]}], "==", 
        RowBox[{"A12", " ", 
         RowBox[{"f", "[", "2", "]"}]}]}]}], "}"}], "/.", "levelIIsub"}], "//",
