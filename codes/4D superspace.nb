Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"**", " ", "Declaring"}], " ", "field", " ", "variables"}], " ", 
   "***)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"bosons", "=", 
     RowBox[{"{", 
      RowBox[{
      "\[Phi]", ",", "\[Phi]bar", ",", "F", ",", "Fbar", ",", "A", ",", 
       "Dterm"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"regfermions", "=", 
     RowBox[{"{", 
      RowBox[{
      "\[Psi]", ",", "\[Psi]bar", ",", "\[Lambda]", ",", "\[Lambda]bar", ",", 
       "\[Theta]", ",", "\[Theta]bar"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"componentfields", "=", 
     RowBox[{"{", 
      RowBox[{
      "\[Phi]", ",", "\[Phi]bar", ",", "F", ",", "Fbar", ",", "\[Psi]", ",", 
       "\[Psi]bar", ",", "A", ",", "Dterm", ",", "\[Lambda]", ",", 
       "\[Lambda]bar"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"coords", "=", 
     RowBox[{"{", 
      RowBox[{"x", ",", "\[Theta]", ",", "\[Theta]bar"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"supercoords", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[Theta]", "[", "1", "]"}], ",", 
       RowBox[{"\[Theta]", "[", "2", "]"}], ",", 
       RowBox[{"\[Theta]bar", "[", "1", "]"}], ",", 
       RowBox[{"\[Theta]bar", "[", "2", "]"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"allfields", "=", 
     RowBox[{"Join", "[", 
      RowBox[{"bosons", ",", "regfermions"}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Theta]d", "[", "a_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "b", "}"}], ",", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"\[Theta]", "[", "b", "]"}], " ", 
         RowBox[{"eps", "[", 
          RowBox[{"[", 
           RowBox[{"b", ",", "a"}], "]"}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"b", ",", "1", ",", "2"}], "}"}]}], "]"}]}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Theta]bard", "[", "a_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "b", "}"}], ",", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"\[Theta]bar", "[", "b", "]"}], " ", 
         RowBox[{"eps", "[", 
          RowBox[{"[", 
           RowBox[{"b", ",", "a"}], "]"}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"b", ",", "1", ",", "2"}], "}"}]}], "]"}]}], "]"}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Psi]u", "[", "a_", "]"}], "[", "xvar___", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "b", "}"}], ",", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"eps", "[", 
          RowBox[{"[", 
           RowBox[{"a", ",", "b"}], "]"}], "]"}], " ", 
         RowBox[{
          RowBox[{"\[Psi]", "[", "b", "]"}], "[", "xvar", "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"b", ",", "1", ",", "2"}], "}"}]}], "]"}]}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Psi]baru", "[", "a_", "]"}], "[", "xvar___", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "b", "}"}], ",", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"eps", "[", 
          RowBox[{"[", 
           RowBox[{"a", ",", "b"}], "]"}], "]"}], " ", 
         RowBox[{
          RowBox[{"\[Psi]bar", "[", "b", "]"}], "[", "xvar", "]"}]}], ",", 
        RowBox[{"{", 
