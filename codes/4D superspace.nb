   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Lambda]u", "[", "a_", "]"}], "[", "xvar___", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "b", "}"}], ",", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"eps", "[", 
          RowBox[{"[", 
